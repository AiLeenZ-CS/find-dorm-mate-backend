DATABASE_URL="mysql://root:@localhost:3306/find_dorm_mate_db"

# ใช้ค่าสุ่มยาวๆ (เช่น openssl rand -hex 32) ห้ามใช้ค่าตัวอย่างนี้จริง
JWT_SECRET="change_me_to_a_long_random_secret"

# บัญชี Master Admin ตัวแรกของระบบ (สร้างผ่าน `npm run db:seed`)
SEED_MASTER_ADMIN_EMAIL="admin@example.com"
SEED_MASTER_ADMIN_USERNAME="master_admin"
SEED_MASTER_ADMIN_PASSWORD="change_me"

# สำหรับ image proxy ผ่าน Firebase Admin SDK - ดูวิธีตั้งค่าใน src/config/firebase-admin.ts
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"

# สำหรับส่งอีเมลลืมรหัสผ่าน (Gmail App Password, 16 หลัก ไม่มีเว้นวรรค)
SMTP_USER="your-gmail-address@gmail.com"
SMTP_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# URL สาธารณะของ backend เอง ใช้สร้างลิงก์ reset password ที่ส่งไปในอีเมล
# ค่าเริ่มต้น 10.0.2.2 ใช้ได้เฉพาะตอน dev ผ่าน Android emulator เท่านั้น เปลี่ยนเป็นโดเมนจริงตอน deploy
BACKEND_PUBLIC_URL="http://10.0.2.2:3000"

PORT=3000

# จำกัด origin ที่เรียก API นี้ได้ (คั่นด้วย comma) — ไม่ตั้งค่า = เปิดรับทุก origin (ใช้ตอน dev เท่านั้น)
# ต้องตั้งค่านี้ก่อน deploy production เช่น:
# ALLOWED_ORIGINS="https://admin.yourdomain.com,https://app.yourdomain.com"
ALLOWED_ORIGINS=
